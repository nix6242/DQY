@echo off
setlocal EnableExtensions DisableDelayedExpansion
call "%~dp0_lab-guard.cmd" ready
if errorlevel 1 exit /b 1
set "CMD_LAB_KIT_DIR=%~dp0"
rem Read-only checks. PowerShell is a Windows built-in helper, not CMD syntax.
powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; try { $root=Join-Path $env:USERPROFILE 'CMD-Lab'; $kit=$env:CMD_LAB_KIT_DIR; $expected=Get-Content -LiteralPath (Join-Path $kit 'expected-fixtures.json') -Raw | ConvertFrom-Json; $actual=@(Get-ChildItem -LiteralPath (Join-Path $root 'data') -File -Recurse -Force); if ($actual.Count -ne 5) { throw ('Expected 5 data files, found '+$actual.Count) }; foreach ($e in $expected.files) { $path=Join-Path (Join-Path $root 'data') $e.path; if (!(Test-Path -LiteralPath $path -PathType Leaf)) { throw ('Missing fixture: '+$e.path) }; if ((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash -ine $e.sha256) { throw ('Fixture changed: '+$e.path) } }; $report=Join-Path $root 'outputs\report.txt'; if (Test-Path -LiteralPath $report) { $manifest=Join-Path $root 'outputs\report.sha256'; if (!(Test-Path -LiteralPath $manifest -PathType Leaf)) { throw 'Report hash is missing.' }; $hash=[IO.File]::ReadAllText($manifest).Trim(); if ($hash -notmatch '^[A-Fa-f0-9]{64}$' -or (Get-FileHash -LiteralPath $report -Algorithm SHA256).Hash -ine $hash) { throw 'Report hash mismatch.' }; $expectedLines=New-Object 'System.Collections.Generic.List[string]'; $expectedLines.Add('DQY CMD LAB GENERATED REPORT V1'); $expectedLines.Add('Search: ERROR in data\logs\app.log'); $lines=[IO.File]::ReadAllLines((Join-Path $root 'data\logs\app.log')); for ($n=0; $n -lt $lines.Length; $n++) { if ($lines[$n] -match 'ERROR') { $expectedLines.Add((($n+1).ToString()+':'+$lines[$n])) } }; $actualLines=[IO.File]::ReadAllLines($report); if ($actualLines.Length -ne $expectedLines.Count) { throw 'Report line count is wrong.' }; for ($n=0; $n -lt $actualLines.Length; $n++) { if ($actualLines[$n] -cne $expectedLines[$n]) { throw 'Report content is wrong.' } }; Write-Output '[PASS] Report content and hash match.' } else { if (Test-Path -LiteralPath (Join-Path $root 'outputs\report.sha256')) { throw 'Orphan report hash exists without a report.' }; Write-Output '[NOTE] No report present. Run 02-search-report.cmd to create one.' }; Write-Output '[PASS] Five fixture hashes and markers match.'; exit 0 } catch { [Console]::Error.WriteLine('[VERIFY] '+$_.Exception.Message); exit 1 }"
set "VERIFY_RC=%ERRORLEVEL%"
exit /b %VERIFY_RC%
