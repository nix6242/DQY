@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "CMD_LAB_GUARD_MODE="
if /i "%~1"=="prepare" set "CMD_LAB_GUARD_MODE=prepare"
if /i "%~1"=="ready" set "CMD_LAB_GUARD_MODE=ready"
if /i "%~1"=="report-write" set "CMD_LAB_GUARD_MODE=report-write"
if /i "%~1"=="cleanup-verify" set "CMD_LAB_GUARD_MODE=cleanup-verify"
if not defined CMD_LAB_GUARD_MODE exit /b 2
rem Static PowerShell command: no ExecutionPolicy override, no script download.
powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; try { $mode=$env:CMD_LAB_GUARD_MODE; if ([string]::IsNullOrWhiteSpace($env:USERPROFILE)) { throw 'USERPROFILE is empty.' }; $userProfilePath=[IO.Path]::GetFullPath($env:USERPROFILE); $root=[IO.Path]::GetFullPath((Join-Path $userProfilePath 'CMD-Lab')); if ($root -ne (Join-Path $userProfilePath 'CMD-Lab')) { throw 'Unexpected lab path.' }; $item=Get-Item -LiteralPath $userProfilePath -Force; while ($null -ne $item) { if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw ('Reparse point in profile path: '+$item.FullName) }; $item=$item.Parent }; $marker=Join-Path $root '.cmd-lab-marker'; $magic='DQY_CMD_LAB_V1'+[Environment]::NewLine; if (Test-Path -LiteralPath $root) { $ri=Get-Item -LiteralPath $root -Force; if (!$ri.PSIsContainer -or (($ri.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0)) { throw 'Lab root is not an ordinary directory.' }; if (!(Test-Path -LiteralPath $marker -PathType Leaf) -or [IO.File]::ReadAllText($marker) -cne $magic) { throw 'Existing lab is not marked. Nothing was changed.' } } elseif ($mode -eq 'prepare') { [void][IO.Directory]::CreateDirectory($root); [IO.File]::WriteAllText($marker,$magic,[Text.Encoding]::ASCII) } else { throw 'Run 00-create-lab.cmd first.' }; $todo=New-Object 'System.Collections.Generic.Stack[string]'; $todo.Push($root); while ($todo.Count -gt 0) { $dir=$todo.Pop(); foreach ($i in Get-ChildItem -LiteralPath $dir -Force) { if (($i.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw ('Reparse point in lab: '+$i.FullName) }; if ($i.PSIsContainer) { $todo.Push($i.FullName) } } }; $out=Join-Path $root 'outputs'; $om=Join-Path $out '.cmd-lab-output-marker'; $omagic='DQY_CMD_OUTPUT_V1'+[Environment]::NewLine; if ($mode -eq 'prepare' -and !(Test-Path -LiteralPath $out)) { [void][IO.Directory]::CreateDirectory($out); [IO.File]::WriteAllText($om,$omagic,[Text.Encoding]::ASCII) }; if (!(Test-Path -LiteralPath $om -PathType Leaf) -or [IO.File]::ReadAllText($om) -cne $omagic) { throw 'Output folder is not marked. Nothing was changed.' }; if ($mode -eq 'prepare') { foreach ($rel in @('data','data\logs','data\code','backups')) { [void][IO.Directory]::CreateDirectory((Join-Path $root $rel)) } }; if (!(Test-Path -LiteralPath (Join-Path $root 'data') -PathType Container)) { throw 'Data folder is missing.' }; $report=Join-Path $out 'report.txt'; $manifest=Join-Path $out 'report.sha256'; if (($mode -eq 'report-write' -and (Test-Path -LiteralPath $report)) -or $mode -eq 'cleanup-verify') { if (!(Test-Path -LiteralPath $report -PathType Leaf) -or !(Test-Path -LiteralPath $manifest -PathType Leaf)) { throw 'Report or hash manifest is missing.' }; $expected=[IO.File]::ReadAllText($manifest).Trim(); if ($expected -notmatch '^[A-Fa-f0-9]{64}$' -or (Get-FileHash -LiteralPath $report -Algorithm SHA256).Hash -ine $expected) { throw 'Report was edited or manifest is invalid. File was preserved.' } }; if ($mode -eq 'report-write') { if ((Test-Path -LiteralPath $manifest) -and !(Test-Path -LiteralPath $report)) { throw 'Orphan hash manifest exists. File was preserved; review it manually.' }; foreach ($p in @($report,$manifest)) { if ((Test-Path -LiteralPath $p) -and ((Get-Item -LiteralPath $p -Force).Attributes -band [IO.FileAttributes]::ReadOnly) -ne 0) { throw 'Read-only report or manifest was preserved.' } }; foreach ($p in @((Join-Path $out 'report.pending.txt'),(Join-Path $out 'report.sha256.pending.txt'))) { if (Test-Path -LiteralPath $p) { throw 'Pending report file already exists. Review it manually; nothing was overwritten.' } } }; Write-Output ('[GUARD] OK: '+$mode); exit 0 } catch { [Console]::Error.WriteLine('[GUARD] '+$_.Exception.Message); exit 20 }"
set "GUARD_RC=%ERRORLEVEL%"
exit /b %GUARD_RC%
